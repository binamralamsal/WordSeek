{
  "name": "word-guesser-bot",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:check": "bun test --check",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "typecheck": "bun check",
    "check:web": "bunx tsc -p web/tsconfig.json --noEmit",
    "build:miniapp": "vite build --config web/vite.config.ts",
    "dev:miniapp": "vite --config web/vite.config.ts",
    "preview:miniapp": "vite preview --config web/vite.config.ts",
    "verify": "bun run fmt:check && bun run lint && bun run typecheck && bun run check:web && bun test",
    "db:migrate": "kysely migrate",
    "db:seed": "kysely seed",
    "db:compact": "bun run scripts/truncate-leaderboard-rows.ts",
    "db:codegen": "kysely-codegen --out-file ./src/database/schema.ts --singularize --camel-case"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.4.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.7"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/parse-mode": "^2.3.0",
    "@grammyjs/runner": "^2.0.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.107.1",
    "bullmq": "^6.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron": "^4.4.0",
    "elysia": "^2.0.0-rc.4",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.7",
    "kysely-ctl": "^0.22.0",
    "lucide-react": "^1.70.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "word-definition": "^2.1.6",
    "zod": "^4.6.7"
  }
}
