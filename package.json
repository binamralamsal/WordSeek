{
  "name": "word-guesser-bot",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "db:migrate": "kysely migrate",
    "db:seed": "kysely seed",
    "db:codegen": "kysely-codegen --out-file ./src/database/schema.ts --singularize --camel-case",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "1.4.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "kysely-codegen": "^0.20.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/parse-mode": "^2.3.0",
    "@grammyjs/runner": "^2.0.3",
    "bullmq": "^6.4.1",
    "cron": "^4.4.0",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.7",
    "kysely-ctl": "^0.22.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "word-definition": "^2.1.6",
    "zod": "^4.6.7"
  }
}
